# Local development only. Defaults match backend/docker-compose.yml.
# Generate backend/.env with: node backend/scripts/setup-local-env.mjs
# Never commit the generated .env or use these local credentials in production.
DB_HOST=localhost
DB_USERNAME=lms_user
DB_PASSWORD=lms_pass
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=lms_minio_admin
MINIO_SECRET_KEY=lms_minio_secret123
MINIO_CERTIFICATES_BUCKET=lms-certificates
MAIL_HOST=localhost
MAIL_PORT=1025
APP_FRONTEND_BASE_URL=http://localhost:5173

# Install FFmpeg (with libx264 and AAC) on the machine running content-service.
# Optional executable paths, e.g. C:/ffmpeg/bin/ffmpeg.exe on Windows:
# VIDEO_FFMPEG=ffmpeg
# VIDEO_FFPROBE=ffprobe

# The setup script generates separate cryptographically random keys.
# Existing JWT_SECRET / INTERNAL_API_KEY process bindings are reused.
JWT_SECRET=
INTERNAL_API_KEY=
