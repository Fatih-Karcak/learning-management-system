# DNS: both names must resolve to the VPS; allow TCP 80/443 and UDP 443.
APP_DOMAIN=academy.example.com
S3_DOMAIN=files.example.com
TLS_EMAIL=ops@example.com
DB_PASSWORD=replace-with-random-secret
JWT_SECRET=replace-with-at-least-64-random-characters
INTERNAL_API_KEY=replace-with-at-least-48-random-characters
MFA_ENCRYPTION_KEY=replace-with-at-least-64-random-characters
MINIO_ACCESS_KEY=replace-with-random-access-key
MINIO_SECRET_KEY=replace-with-at-least-32-random-characters
# Optional: use the pinned source build described in STAGING.md if the official registry is unavailable.
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-secret
MAIL_FROM=academy@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Only for first startup. Remove both after creating the administrator.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
RELEASE_TAG=local
# Optional existing payments workflow: docker compose --profile payments ...
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional off-site media backup. Pre-create a private bucket with versioning enabled.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
